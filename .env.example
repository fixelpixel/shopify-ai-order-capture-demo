# Copy to .env and run: node --env-file=.env src/server.mjs
# Values below are placeholders. Never commit a real .env.

# App client secret used to verify X-Shopify-Hmac-Sha256 (required)
SHOPIFY_API_SECRET=
# Previous secret while a rotation takes effect (optional)
SHOPIFY_API_SECRET_PREVIOUS=

# GraphQL Admin API lookup for Order.attribution / app / publication (optional; needs read_orders)
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07

# GA4 Measurement Protocol. Nothing is posted unless both are set AND --send or --validate is passed.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# global (default) or eu
GA4_REGION=global

PORT=8787
HOST=127.0.0.1
LEDGER_PATH=data/ledger.jsonl
# memory (default) or file
DEDUP_STORE=memory
DEDUP_PATH=data/webhook-ids.jsonl
PURCHASE_DEDUP_PATH=data/purchases.jsonl
